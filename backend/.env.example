# Copy this file to .env and fill in the values.
# Get keys via docs/ACCOUNTS_SETUP_GUIDE.md
# NEVER commit .env (.gitignore already excludes it).

# ── Claude API ──
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE
# Default model. Change to a specific dated ID if needed.
ANTHROPIC_MODEL=claude-opus-4-5

# ── Alpaca paper trading (real broker, paper money) ──
ALPACA_API_KEY=PK_REPLACE
ALPACA_API_SECRET=REPLACE
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Holdings (Interactive Brokers Flex Web Service — W1, read-only) ──────────
# Powers the daily WhatsApp briefing's "what moved" layer (the pivot product).
# Read-only XML reports via a 2-step flow: SendRequest(token, queryId) -> a
# ReferenceCode, then GetStatement(ReferenceCode) -> the statement XML.
# Set up an *Activity* Flex Query (Account Mgmt → Performance & Reports → Flex
# Queries) with these sections: Open Positions + Net Asset Value (NAV) in Base +
# Mark-to-Market Performance Summary in Base (+ Change in NAV, Month & Year to
# Date Performance, Realized & Unrealized Performance, Financial Instrument
# Information). Delivery: Format=XML, Period=Last Business Day. General config:
# Enable Base Currency P&L=ON, Include Currency Rates=Yes, Include Audit Trail
# Fields=No, date format yyyy-MM-dd, Breakout by Day=No.
# Then create a Flex Web Service token (Reporting → Settings → Flex Web Service).
# USE_MOCK_IBKR=1 parses the bundled backend/data/mock_flex_statement.xml (offline
# demo). Unset it AND set a real token + query id to pull a live statement.
USE_MOCK_IBKR=1
IBKR_FLEX_TOKEN=REPLACE
IBKR_FLEX_QUERY_ID=REPLACE
IBKR_FLEX_TIMEOUT_S=30

# ── Briefing generator (W2 — the daily WhatsApp narrative) ───────────────────
# System-side generator (NOT an agent tool): Flex holdings (W1) + market context
# → a single tool-less Claude call → WhatsApp-ready prose. Reuses ANTHROPIC_API_KEY
# + ANTHROPIC_MODEL above.
# USE_MOCK_BRIEFING=1 (or no ANTHROPIC_API_KEY) → deterministic template prose,
# no API spend (offline demo + the W2 offline test). Unset it (with a key set) to
# have Claude write the narrative. Independent of USE_MOCK_IBKR — you can write a
# real Claude brief over the mock Flex fixture.
USE_MOCK_BRIEFING=1
# Optional: route the narrative to a cheaper model than the chat ANTHROPIC_MODEL.
# BRIEFING_MODEL=claude-haiku-4-5-20251001
BRIEFING_MAX_CHARS=1500
BRIEFING_TOP_MOVERS=4
# Headline freshness window (days), anchored to the statement's as_of date: a
# mover's news must be at/after (as_of − this) to be offered as a cause, so a
# stale headline can't explain today's move. Raise it if quiet-day briefs lose
# too much "why"; lower it for stricter freshness.
BRIEFING_NEWS_MAX_AGE_DAYS=2

# ── WhatsApp delivery (W3 — Twilio, system-side; NEVER an agent tool) ────────
# Sends the daily briefing over WhatsApp. The scheduler (W5) imports
# backend/whatsapp.py and calls it; the agent has no send tool (SECURITY threat 1).
# USE_MOCK_WHATSAPP=1 (or missing creds) → LOG the message instead of sending
# (offline dev; lets the W5 cron be tested without spending/spamming). `twilio` is
# only needed for real sends: `uv sync --group whatsapp`.
# Sandbox (validation cohort): Twilio Console → Messaging → Try it out → Send a
# WhatsApp message; each tester sends the "join <phrase>" code once (opt-in), then
# TWILIO_WHATSAPP_FROM is the sandbox number. Production (W6) needs a registered
# WhatsApp Business sender + approved templates. Full guide: self_management/TWILIO_SETUP.md.
USE_MOCK_WHATSAPP=1
TWILIO_ACCOUNT_SID=AC_REPLACE
TWILIO_AUTH_TOKEN=REPLACE
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── IBKR connect storage (W4 — encrypted Flex token at rest) ─────────────────
# The connect flow stores each user's Flex token ENCRYPTED (app-side Fernet,
# backend/token_crypto.py — uses the existing `cryptography` dep, no new package).
# Mint a key: `cd backend && .venv/bin/python -m token_crypto` → paste below.
# Rotating the key invalidates stored ciphertext. NEVER commit a real key.
FLEX_TOKEN_ENC_KEY=REPLACE
# NOTE: the W5 cron reads ALL opted-in connections via the Supabase SERVICE KEY
# (service_role bypasses RLS — the one legitimate admin path, a backend job, never
# a user request). Set SUPABASE_SERVICE_KEY below for that system read. The
# connect ENDPOINT itself uses the user's JWT + RLS, not the service key.

# ── Supabase (auth + Postgres) ──
SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_ANON_KEY=eyJREPLACE
SUPABASE_SERVICE_KEY=eyJREPLACE
# JWT verification (P4.1 / proposal 015). The backend verifies the access token
# by its header `alg`:
#   • Asymmetric "JWT Signing Keys" (ES256/RS256 — Supabase's current default):
#     verified against the project's published public keys (JWKS) at
#     <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Needs SUPABASE_URL above
#     (+ SUPABASE_ANON_KEY, sent as the `apikey` header). No secret required.
#   • Legacy symmetric secret (HS256): set SUPABASE_JWT_SECRET below
#     (Supabase → Settings → API → "JWT Secret"). Only needed for HS256 projects.
SUPABASE_JWT_SECRET=REPLACE

# ── Auth enforcement (P4.1) ──
# REQUIRE_AUTH=1 → reject unauthenticated POST /api/chat (401) and derive
# user_id from the JWT, killing the spoofable "demo" default (SECURITY_AUDIT
# HIGH-2). SET THIS TO 1 IN PRODUCTION (Railway).
# Unset/0 (local) → if a Bearer token is sent it's still verified, but a request
# WITHOUT a token falls back to the "demo" user — so the deterministic mock demo,
# scripts/smoke_test.sh and curl checks keep working.
REQUIRE_AUTH=0

# ── Langfuse observability (P4.4 / proposal 017) ──
# Per-turn traces for the agent loop (one root span "chat", a `generation`
# child per Anthropic call, a `tool:<name>` child per tool call). Tagged with
# the authenticated user_id and the conversation_id (as Langfuse session_id).
# Unset / placeholder → tracing is a silent no-op; nothing fails.
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE
LANGFUSE_SECRET_KEY=sk-lf-REPLACE
# ^ Region (default = US cloud). Common values:
#   https://cloud.langfuse.com   (US)
#   https://eu.cloud.langfuse.com (EU)
#   https://jp.cloud.langfuse.com (JP / APAC)
#   http://localhost:3000        (self-hosted; conflicts with the frontend port if both run locally)

# ── Mem0 memory (P4.3 / proposal 025) ──
# Per-user fact recall across conversations. Before each turn the backend
# searches THIS user's memories (scoped by the authenticated user_id) and
# injects them into the system prompt; after the turn it stores new salient
# facts. Scope is ALWAYS the verified Supabase UUID — never a client value.
# Requires the optional `memory` dependency group: `uv sync --group memory`.
# Unset / placeholder → memory is a silent no-op; nothing fails.
MEM0_API_KEY=m0-REPLACE
# Max memories injected per turn (bounds system-prompt token growth).
MEM0_SEARCH_LIMIT=5
# Hard cap on total characters of the injected memory block.
MEM0_MAX_CHARS=1500

# ── PostHog (analytics) ──
POSTHOG_API_KEY=phc_REPLACE
POSTHOG_HOST=https://us.i.posthog.com

# ── TradingView MCP (P1.2 — local-dev / demo only) ─────────────────────────
# Real chart manipulation requires TradingView Desktop running on the SAME
# machine with --remote-debugging-port=9222 enabled. In Railway production
# there is no TV Desktop, so leave USE_MOCK_TA=1 there.
# See README.md "Talk-to-your-charts" for one-time setup.
#
# LIMITATION: USE_MOCK_TA=0 alone is NOT enough — TradingView Desktop must
# ALSO be open with the debug port. Launch it with:
#   open -a "TradingView" --args --remote-debugging-port=9222
# Verify: `curl -s localhost:9222/json/version` (look for "TVDesktop" in the UA).
# If TV Desktop is closed while USE_MOCK_TA=0, the chart degrades to mock data
# (now labelled `TradingView (mocked — live data unavailable)`, proposal 029).
USE_MOCK_TA=1
TRADINGVIEW_MCP_COMMAND=node
# Absolute path to the sibling-cloned tradesdontlie/tradingview-mcp repo's server.
# Example: /Users/you/Code/tradingview-mcp/src/server.js
TRADINGVIEW_MCP_ARGS=REPLACE_WITH_ABSOLUTE_PATH/tradingview-mcp/src/server.js
TRADINGVIEW_MCP_CDP_PORT=9222

# ── Research data (P2b — Financial Modeling Prep) ───────────────────────────
# FMP is the research/fundamentals provider behind get_full_research /
# get_consensus_targets / get_company_fundamentals / get_peer_set.
# USE_MOCK_RESEARCH=1 forces the hand-tuned 7-ticker mocks (deterministic demo).
# Unset it AND set a real FMP_API_KEY to cover any US ticker.
USE_MOCK_RESEARCH=1
FMP_API_KEY=REPLACE
FMP_TIMEOUT_S=10

# ── Runtime config ──
CORS_ALLOW_ORIGINS=http://localhost:3000
MAX_TOOL_ITERATIONS=10
PER_USER_RATE_LIMIT_PER_MIN=30
MAX_PAPER_TRADE_NOTIONAL=50000
