    "/api/portfolio": {
      "get": {
        "description": "Lightweight portfolio summary for the frontend Hero header.\n\nReturns only the header fields (total equity + today's P&L) \u2014 NOT the full\npositions list \u2014 so the home screen header doesn't over-expose holdings on a\nnon-chat endpoint. `get_portfolio` is the single source of truth and is\nitself mock-gated, so demo mode (no token) returns the mock total.",
        "operationId": "portfolio_endpoint_api_portfolio_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
