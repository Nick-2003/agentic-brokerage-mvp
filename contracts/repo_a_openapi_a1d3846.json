{
  "components": {
    "schemas": {
      "Attachment": {
        "description": "One user-uploaded image for a single chat turn (059).\n\n`data` is raw base64 (NO `data:<mime>;base64,` prefix \u2014 the client strips it).\nEphemeral: forwarded to the model for this turn only, never persisted.",
        "properties": {
          "data": {
            "maxLength": 7000000,
            "minLength": 1,
            "title": "Data",
            "type": "string"
          },
          "kind": {
            "const": "image",
            "default": "image",
            "title": "Kind",
            "type": "string"
          },
          "media_type": {
            "maxLength": 64,
            "title": "Media Type",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "media_type",
          "data"
        ],
        "title": "Attachment",
        "type": "object"
      },
      "BrokerAccountSelectRequest": {
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          }
        },
        "required": [
          "account_id"
        ],
        "title": "BrokerAccountSelectRequest",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "attachments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Attachment"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attachments"
          },
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "message": {
            "default": "",
            "maxLength": 4096,
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ChatRequest",
        "type": "object"
      },
      "ConnectRequest": {
        "properties": {
          "email_opt_in": {
            "default": false,
            "title": "Email Opt In",
            "type": "boolean"
          },
          "flex_query_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Flex Query Id",
            "type": "string"
          },
          "flex_token": {
            "maxLength": 512,
            "minLength": 8,
            "title": "Flex Token",
            "type": "string"
          },
          "opt_in": {
            "default": true,
            "title": "Opt In",
            "type": "boolean"
          },
          "whatsapp_number": {
            "maxLength": 24,
            "title": "Whatsapp Number",
            "type": "string"
          }
        },
        "required": [
          "flex_token",
          "flex_query_id",
          "whatsapp_number"
        ],
        "title": "ConnectRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OptInRequest": {
        "properties": {
          "opt_in": {
            "title": "Opt In",
            "type": "boolean"
          }
        },
        "required": [
          "opt_in"
        ],
        "title": "OptInRequest",
        "type": "object"
      },
      "SnapTradeSessionRequest": {
        "properties": {
          "broker": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broker"
          }
        },
        "title": "SnapTradeSessionRequest",
        "type": "object"
      },
      "SnapTradeVerifyRequest": {
        "properties": {
          "external_connection_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "External Connection Id",
            "type": "string"
          }
        },
        "required": [
          "external_connection_id"
        ],
        "title": "SnapTradeVerifyRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WaitlistRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "required": [
          "email"
        ],
        "title": "WaitlistRequest",
        "type": "object"
      }
    }
  },
