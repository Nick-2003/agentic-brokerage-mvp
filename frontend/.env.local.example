## Frontend env — copy to .env.local for local dev
## In production these are set in Vercel project settings.

# Local backend URL. In production point this to your Railway backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (frontend uses anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJREPLACE

# PostHog
NEXT_PUBLIC_POSTHOG_API_KEY=phc_REPLACE
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
